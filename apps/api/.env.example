# ── Database ──────────────────────────────────────────────
OPSPILOT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opspilot

# ── Auth / JWT ────────────────────────────────────────────
OPSPILOT_JWT_SECRET=change-me-in-production
OPSPILOT_JWT_ALGORITHM=HS256
OPSPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=30
OPSPILOT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Auth provider: "jwt" | "firebase" ────────────────────
OPSPILOT_AUTH_PROVIDER=jwt

# ── CORS ──────────────────────────────────────────────────
OPSPILOT_CORS_ORIGINS=["http://localhost:3000"]
